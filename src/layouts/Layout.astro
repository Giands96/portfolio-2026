---
import { Font } from "astro:assets";
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <Font cssVariable="--font-Inter" preload />
    <Font cssVariable="--font-AkiraExpanded" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>My Portfolio - Axel</title>
  </head>
  <body>
    <div class="cursor-background"></div>

    <slot />
    <script>
      import Lenis from "lenis";
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      if (!reduceMotion) {
        const lenis = new Lenis({
          duration: 1.2,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        });

        lenis.on("scroll", ScrollTrigger.update);

        gsap.ticker.add((time) => {
          lenis.raf(time * 1000);
        });
        gsap.ticker.lagSmoothing(0);

        (window as any).lenis = lenis;
      }

      let mouseX = 0;
      let mouseY = 0;
      let cursorX = 0;
      let cursorY = 0;
      let fadeTimeout: any;
      let isInteractive = false; // ← Nueva variable

      const cursor = document.querySelector(
        ".cursor-background",
      ) as HTMLElement;

      document.addEventListener("mousemove", (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;

        if (!cursor) return;

        // Mostrar cursor
        cursor.style.opacity = "1";
        clearTimeout(fadeTimeout);
        fadeTimeout = setTimeout(() => {
          cursor.style.opacity = "0";
        }, 2000);

        // Detectar elementos interactivos
        const interactive = (e.target as HTMLElement).closest(
          'a, button, [role="button"], input, textarea, .cursor-pointer',
        );

        isInteractive = !!interactive;
      });

      function animateCursor() {
        // Suavizar movimiento
        cursorX += (mouseX - cursorX) * 0.12;
        cursorY += (mouseY - cursorY) * 0.12;

        if (cursor) {
          const scale = isInteractive ? 1.6 : 1;

          cursor.style.transform = `translate3d(${cursorX - 40}px, ${cursorY - 40}px, 0) scale(${scale})`;
        }

        requestAnimationFrame(animateCursor);
      }

      if (
        cursor &&
        window.matchMedia("(pointer: fine)").matches &&
        !reduceMotion
      ) {
        animateCursor();
      } else if (cursor) {
        cursor.style.display = "none";
      }
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  .cursor-background {
    position: fixed;
    top: 0;
    left: 0;
    opacity: 0;
    width: 80px;
    height: 80px;
    border-radius: 100%;
    pointer-events: none;
    z-index: 9999;
    background-color: white;
    mix-blend-mode: difference;
    transition: transform 0.08s ease-out;
  }

  @media (pointer: coarse) {
    .cursor-background {
      display: none;
    }
  }
</style>
