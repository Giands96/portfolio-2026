---
import { Font } from 'astro:assets';
import '../styles/global.css'
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<Font cssVariable="--font-Inter" preload />
		<Font cssVariable="--font-AkiraExpanded" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>My Portfolio - Axel</title>
	</head>
	<body>

		<div class="cursor-background">

		</div>


		<slot />
	<script>
		import Lenis from 'lenis';

		const lenis = new Lenis({
			autoRaf: true
		});

		let mouseX = 0;
		let mouseY = 0;
		let cursorX = 0;
		let cursorY = 0;
		let fadeTimeout: any;
 
		document.addEventListener('mousemove', (e) => {

			mouseX = e.clientX;
			mouseY = e.clientY;

			const cursor = document.querySelector('.cursor-background') as HTMLElement;
			if (cursor) {
				cursor.style.opacity = '1';
				cursor.style.transition = 'opacity 1s ease-out';
				// Reiniciar el temporizador de desvanecimiento
				clearTimeout(fadeTimeout);

				// Ocultar el cursor después de 2 segundos de inactividad
				fadeTimeout = setTimeout(() => {
					cursor.style.opacity = '0';
				}, 2000);
			}

			

		});
				

		function animateCursor() {
			// Suavizar el movimiento del cursor
			cursorX += (mouseX - cursorX) * 0.1;
			// Para el eje Y
			cursorY += (mouseY - cursorY) * 0.1;

			const cursor = document.querySelector('.cursor-background') as HTMLElement;
			if (cursor) {
				cursor.style.transform = `translate3d(${cursorX - 45}px, ${cursorY - 45}px, 0)`;
			}
			requestAnimationFrame(animateCursor);
		}

		animateCursor();

	</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	.cursor-background {
		position: fixed;
		top: 0;
		left: 0;
		opacity: 0;
		width: 80px;
		height: 80px;
		border-radius: 100%;
		pointer-events: none;
		z-index: 9999;
		background-color: white;
		mix-blend-mode: difference;
	}


</style>
