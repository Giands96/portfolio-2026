---
interface Props {
  number: string;
  title: string;
  description: string;
}

const { number, title, description } = Astro.props;
---

<div class="timeline-item flex flex-col">
  <div class="inline-flex w-full text-left items-center">
    <span class="text-xl font-sans-akira whitespace-nowrap">{number}</span>
    <hr class="w-full ml-3 border-black"/>
  </div>
  <div class="text-left">
    <h3 class="text-2xl font-bold uppercase mb-4 font-sans-akira">{title}</h3>
  </div>
  <div class="text-left">
    <p class="font-sans-inter text-gray-600 leading-relaxed">
      {description}
    </p>
  </div>
</div>