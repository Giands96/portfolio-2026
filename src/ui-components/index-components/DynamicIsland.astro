---
const AboutMe = "./about-me";
---

<div
  id="dynamic-island"
  class="absolute top-8 left-1/2 -translate-x-1/2 z-50 flex max-w-[calc(100vw-2rem)]"
>
  <div
    id="dot"
    class="w-37.5 h-10 max-w-[calc(100vw-2rem)] rounded-full bg-black transition-all duration-500 ease-in-out overflow-hidden"
  >
    <div
      id="links"
      class="h-full flex items-center justify-center gap-3 px-3 text-[0.65rem] sm:gap-6 sm:px-4 sm:text-base opacity-0 pointer-events-none transition-opacity duration-300"
    >
      <a
        class="text-white font-sans-akira hover:text-neutral-400 whitespace-nowrap"
        href="/">Inicio</a
      >
      <a
        class="text-white font-sans-akira hover:text-neutral-400 whitespace-nowrap"
        href={AboutMe}>Sobre mi</a
      >
      <a
        class="text-white font-sans-akira hover:text-neutral-400 whitespace-nowrap"
        href="/projects">Proyectos</a
      >
      <a
        class="text-white font-sans-akira hover:text-neutral-400 whitespace-nowrap"
        href="/contact">Contacto</a
      >
    </div>
  </div>
</div>

<script>
  import { gsap } from "gsap";

  // Dynamic Island
  const island = document.getElementById("dot");
  const links = document.getElementById("links");
  const mobileQuery = window.matchMedia("(max-width: 639px)");
  const touchQuery = window.matchMedia("(pointer: coarse)");
  let isOpen = false;

  const getClosedWidth = () => Math.min(250, window.innerWidth - 32);
  const getOpenWidth = () =>
    mobileQuery.matches ? window.innerWidth - 32 : 550;

  gsap.set("#dot", {
    transformOrigin: "center center",
    width: getClosedWidth(),
  });

  const islandTl = gsap.timeline({ delay: 0.2 });
  const hasComplete = sessionStorage.getItem("islandIntroComplete");

  if (!hasComplete) {
    islandTl
      .fromTo(
        "#dot",
        { scaleX: 0.2, scaleY: 0.2, y: -30, opacity: 0 },
        {
          scaleX: 1,
          scaleY: 1,
          y: 0,
          opacity: 1,
          duration: 0.8,
          ease: "back.out(1.5)",
        },
      )
      .to("#dot", {
        width: getClosedWidth(),
        duration: 0.5,
        ease: "power2.inOut",
      })
      .eventCallback("onComplete", () => {
        sessionStorage.setItem("islandIntroComplete", "true");
      });
  } else {
    gsap.set("#dot", {
      scaleX: 1,
      scaleY: 1,
      y: 0,
      opacity: 1,
      width: getClosedWidth(),
    });
  }

  function openIsland() {
    isOpen = true;
    gsap.killTweensOf("#dot");
    gsap.killTweensOf("#links");

    gsap.to("#dot", {
      width: getOpenWidth(),
      duration: 0.25,
      ease: "power2.out",
    });

    gsap.to("#links", {
      opacity: 1,
      duration: 0.2,
      delay: 0.12,
      ease: "power2.out",
      pointerEvents: "auto",
    });
  }

  function closeIsland() {
    isOpen = false;
    gsap.killTweensOf("#dot");
    gsap.killTweensOf("#links");

    gsap.to("#links", {
      opacity: 0,
      duration: 0.2,
      ease: "power2.out",
      pointerEvents: "none",
    });

    gsap.to("#dot", {
      width: getClosedWidth(),
      duration: 0.2,
      delay: 0.05,
      ease: "power2.out",
    });
  }

  island?.addEventListener("mouseenter", openIsland);
  island?.addEventListener("mouseleave", closeIsland);

  island?.addEventListener("click", (event) => {
    if (!touchQuery.matches) return;
    if ((event.target as HTMLElement).closest("a")) return;

    if (isOpen) {
      closeIsland();
    } else {
      openIsland();
    }
  });

  links?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("a")) closeIsland();
  });

  window.addEventListener("resize", () => {
    gsap.set("#dot", { width: isOpen ? getOpenWidth() : getClosedWidth() });
  });
</script>
