---
const AboutMe = "./about-me";
---

<div
  id="dynamic-island"
  class="absolute top-8 left-1/2 -translate-x-1/2 z-50 flex"
>
  <div
    id="dot"
    class="w-37.5 h-10 rounded-full bg-black transition-all duration-500 ease-in-out overflow-hidden-+"
  >
    <div
      id="links"
      class="hover:w-full h-full flex items-center justify-center gap-6 px-4 opacity-0 transition-opacity duration-300"
    >
      <a
        class="text-white font-sans-akira hover:text-neutral-400 whitespace-nowrap"
        href="/">Inicio</a
      >
      <a
        class="text-white font-sans-akira hover:text-neutral-400 whitespace-nowrap"
        href={AboutMe}>Sobre mi</a
      >
      <a
        class="text-white font-sans-akira hover:text-neutral-400 whitespace-nowrap"
        href="/projects">Proyectos</a
      >
      <a
        class="text-white font-sans-akira hover:text-neutral-400 whitespace-nowrap"
        href="/contact">Contacto</a
      >
    </div>
  </div>
</div>

<script>
  import { gsap } from "gsap";

  // Dynamic Island
  const island = document.getElementById("dot");

  gsap.set("#dot", {
    transformOrigin: "center center",
  });

  const islandTl = gsap.timeline({ delay: 0.2 });
  const hasComplete = sessionStorage.getItem("islandIntroComplete");

  if (!hasComplete) {
    islandTl
      .fromTo(
        "#dot",
        { scaleX: 0.2, scaleY: 0.2, y: -30, opacity: 0 },
        {
          scaleX: 1,
          scaleY: 1,
          y: 0,
          opacity: 1,
          duration: 0.8,
          ease: "back.out(1.5)",
        },
      )
      .to("#dot", {
        width: 250,
        duration: 0.5,
        ease: "power2.inOut",
      })
      .eventCallback("onComplete", () => {
        sessionStorage.setItem("islandIntroComplete", "true");
      });
  } else {
    gsap.set("#dot", {
      scaleX: 1,
      scaleY: 1,
      y: 0,
      opacity: 1,
      width: 250,
    });
  }

  function openIsland() {
    gsap.killTweensOf("#dot");
    gsap.killTweensOf("#links");

    gsap.to("#dot", {
      width: 550,
      duration: 0.25,
      ease: "power2.out",
    });

    gsap.to("#links", {
      opacity: 1,
      duration: 0.2,
      delay: 0.12,
      ease: "power2.out",
      pointerEvents: "auto",
    });
  }

  function closeIsland() {
    gsap.killTweensOf("#dot");
    gsap.killTweensOf("#links");

    gsap.to("#links", {
      opacity: 0,
      duration: 0.2,
      ease: "power2.out",
      pointerEvents: "none",
    });

    gsap.to("#dot", {
      width: 250,
      duration: 0.2,
      delay: 0.05,
      ease: "power2.out",
    });
  }

  island?.addEventListener("mouseenter", openIsland);
  island?.addEventListener("mouseleave", closeIsland);
</script>
