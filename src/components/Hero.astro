---
import DynamicIsland from "../ui-components/index-components/DynamicIsland.astro"
import Timeline from "../ui-components/about-me-components/Timeline.astro"
import MyPhoto from "../assets/images/profile.webp"
import Image from "astro/components/Image.astro"
---
  
<DynamicIsland />
<div class="hero-content relative top-32 -z-2 w-full min-h-screen container mx-auto flex flex-col text-center justify-center">
  <div class="relative z-0">
    <p id="hi-im" class="text-[1.75rem] md:text-[2.6rem] italic font-serif text-gray-800 mb-3 opacity-0">
      Hola, Soy Axel
    </p>
    <h1
      id="hero-title"
      class="text-[clamp(2.6rem,6vw,5.5rem)] 
             md:text-[clamp(5rem,6vw,9.8rem)] 
             font-sans-akira uppercase tracking-[-0.04em] leading-[0.82] opacity-0"
    >
      Full Stack <br class="hidden sm:block" /> Developer
    </h1>

  </div>

  <div class="relative z-20 flex justify-center -mt-24 md:-mt-32 pointer-events-none">
    <Image
      id="my-photo"
      src={MyPhoto}
      height={800}
      alt="my-photo"
      class="pointer-events-auto opacity-0"
    />
  </div>
</div>

<style>
  #my-photo{
    mask-image: linear-gradient(to top, transparent, black 15%);
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // ── Animaciones de entrada (igual que el original) ──

  gsap.set("#hi-im", { y: -20, opacity: 0 });
  gsap.to("#hi-im", {
    y: 0,
    opacity: 1,
    duration: 1,
    delay: 2,
    ease: "power2.out",
    onComplete: () => {
      gsap.to("#hi-im", {
        y: 20,
        opacity: 0,
        ease: "none",
        scrollTrigger: {
          trigger: "#hero",
          start: "top top",
          end: "bottom 50%",
          scrub: true,
        },
      });
    },
  });

  gsap.set("#subtitle", { y: 20, opacity: 0 });
  gsap.to("#subtitle", {
    y: 0,
    opacity: 1,
    duration: 1,
    delay: 2.5,
    ease: "power2.out",
    onComplete: () => {
      gsap.to("#subtitle", {
        y: -20,
        opacity: 0,
        ease: "none",
        scrollTrigger: {
          trigger: "#hero",
          start: "top top",
          end: "bottom 50%",
          scrub: true,
        },
      });
    },
  });

  gsap.set("#my-photo", { y: 50, opacity: 0 });
  gsap.to("#my-photo", {
    y: 0,
    opacity: 1,
    duration: 1,
    delay: 3,
    ease: "power2.out",
    onComplete: () => {
      gsap.to("#my-photo", {
        y: -50,
        opacity: 0,
        ease: "none",
        scrollTrigger: {
          trigger: "#hero",
          start: "top top",
          end: "bottom 50%",
          scrub: true,
        },
      });
    },
  });


  const title = document.querySelector<HTMLElement>("#hero-title");
  gsap.set(title, { y: -50, opacity: 0 });
  gsap.to(title, {
    y: 0,
    opacity: 1,
    duration: 1,
    delay: 2.75,
    ease: "power2.out",
    onComplete: () => {
      gsap.to(title, {
        y: 50,
        opacity: 0,
        ease: "none",
        scrollTrigger: {
          trigger: "#hero",
          start: "top top",
          end: "bottom 50%",
          scrub: true,
        },
      });
    },
  });

  // ── Toggle foto ──

  const photo = document.querySelector<HTMLElement>("#my-person");
  const btn   = document.querySelector<HTMLButtonElement>("#photo-btn");
  const icon  = document.querySelector<SVGElement>("#photo-btn-icon");

  // Estado inicial: fuera de pantalla a la derecha
  gsap.set(photo, { x: "100%", opacity: 0 });

  btn?.addEventListener("click", () => {
    const isVisible = photo?.classList.contains("active");

    if (isVisible) {
      gsap.to(photo, {
        x: "100%",
        opacity: 0,
        duration: 0.7,
        ease: "power3.in",
        onComplete: () => {
          photo?.classList.remove("active");
          photo!.style.pointerEvents = "none";
          btn.setAttribute("aria-label", "Mostrar foto");
        },
      });
      gsap.to(icon, { rotation: 0, duration: 0.4, ease: "power2.out" });
    } else {
      photo?.classList.add("active");
      photo!.style.pointerEvents = "auto";
      btn.setAttribute("aria-label", "Ocultar foto");

      gsap.to(photo, {
        x: "0%",
        opacity: 1,
        duration: 0.8,
        ease: "power3.out",
      });
      gsap.to(icon, { rotation: 180, duration: 0.4, ease: "power2.out" });
    }
  });
</script>