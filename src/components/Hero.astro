---
const AboutMe = "./about-me"
import DynamicIsland from "../ui-components/DynamicIsland.astro"
---

<section
  id="hero"
  class="relative w-full min-h-screen flex items-center bg-white text-black overflow-hidden px-6 sm:px-8 md:px-16 py-20 md:py-0"
>
  <DynamicIsland/>

  <div class="hero-content w-full container mx-auto flex flex-col text-center md:text-left  justify-center">
    <p id="hi-im" class="text-[1.75rem] md:text-[2.6rem] italic font-serif text-gray-800 mb-3 opacity-0">
      Hola, Soy Axel
    </p>

    <h1
      id="hero-title"
      class="text-[clamp(2.6rem,9vw,5.5rem)] 
             md:text-[clamp(5rem,8.5vw,9.8rem)] 
             font-sans-akira uppercase tracking-[-0.04em] leading-[0.82] opacity-0"
    >
      Full Stack <br class="hidden sm:block" /> Developer
    </h1>

    <p id="subtitle" class="text-[1.35rem] md:text-[1.75rem] mt-6 font-serif italic text-gray-600 opacity-0">
      UX / UI
    </p>
  </div>

  <div
    id="my-person"
    class="absolute top-[45%] hidden  md:flex right-10  flex-col items-center gap-2 z-20"
  >
    <span class="font-serif  italic text-2xl text-gray-800 text-center leading-tight">
      Hey! estoy <br /> aquí :)
    </span>

    <svg width="40" height="40" viewBox="0 0 100 100" fill="none" class="ml-10 text-gray-800">
      <path
        d="M10 10 Q 50 30 80 80"
        stroke="currentColor"
        stroke-width="2"
        fill="none"
        stroke-linecap="round"
      />
      <path
        d="M65 85 L 80 80 L 85 65"
        stroke="currentColor"
        stroke-width="2"
        fill="none"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </div>
  <div class="md:hidden flex justify-center mt-12">
    <!-- <img src="https://i.pinimg.com/736x/0e/60/7f/0e607f9e752a20879bf3540f157d8c3c.jpg" alt="" width="300" height="800"> -->
  </div>
  

  <button
    class="absolute top-[55%] -right-12 w-24 h-24 bg-[#1a1a1a] rounded-full text-white flex items-center justify-start pl-4 hover:-translate-x-4 transition-transform duration-300 cursor-pointer z-30"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <line x1="19" y1="12" x2="5" y2="12"></line>
      <polyline points="12 19 5 12 12 5"></polyline>
    </svg>
  </button>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);


  // Animación de bienvenida
  gsap.set("#hi-im", {
    y: -20,
    opacity: 0
  });

  gsap.to("#hi-im", {
    y: 0,
    opacity: 1,
    duration: 1,
    delay: 2,
    ease: "power2.out",
    onComplete: () => {
      gsap.to('#hi-im', {
        y:20,
        opacity: 0,
        ease: "none",
        scrollTrigger: {
          trigger: "#hero",
          start: "top top",
          end: "bottom 50%",
          scrub: true,
          
        }
      }); 
    }
  });

  gsap.set("#subtitle", {
    y: 20,
    opacity: 0
  });

  gsap.to("#subtitle", {
    y: 0,
    opacity: 1,
    duration: 1,
    delay: 2.5,
    ease: "power2.out",
    onComplete: () => {
      gsap.to('#subtitle', {
        y:-20,
        opacity: 0,
        ease: "none",
        scrollTrigger: {
          trigger: "#hero",
          start: "top top",
          end: "bottom 50%",
          scrub: true,
          
        }
      }); 
    }
  });

const title = document.querySelector<HTMLElement>("#hero-title");


  gsap.set(title, {
    y: -50,
    opacity: 0
  });

  // Aparición inicial del título
  gsap.to(title, {
    y: 0,
    opacity: 1,
    duration: 1,
    delay: 2.75,
    ease: "power2.out",
    onComplete: () => {
      // Fade al hacer scroll, y reaparece al volver arriba
      gsap.to(title, {
        y: 50,
        opacity: 0,
        ease: "none",
        scrollTrigger: {
          trigger: "#hero",
          start: "top top",
          end: "bottom 50%",
          scrub: true,
          
        }
      });
    }
  });

  
</script>