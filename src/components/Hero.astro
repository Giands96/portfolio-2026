---
import AboutMe from "../pages/aboutMe.astro"

---

<section
  id="hero"
  class="relative w-full h-screen flex items-center bg-white text-black overflow-hidden px-8 md:px-16"
>
  <div id="dynamic-island" class="fixed top-8 left-1/2 -translate-x-1/2 z-50 lg:flex hidden">
    <div
      id="dot"
      class="w-[150px] h-10 rounded-full bg-black transition-all duration-500 ease-in-out overflow-hidden-+"
    >
      <div
        id="links"
        class="hover:w-full h-full flex items-center justify-center gap-6 px-4 opacity-0 transition-opacity duration-300"
      >
        <a class="text-white font-sans-akira hover:text-neutral-400 whitespace-nowrap" href="#">Inicio</a>
        <a class="text-white font-sans-akira hover:text-neutral-400 whitespace-nowrap" href="/aboutMe">Sobre mí</a>
        <a class="text-white font-sans-akira hover:text-neutral-400 whitespace-nowrap" href="/projects">Proyectos</a>
        <a class="text-white font-sans-akira hover:text-neutral-400 whitespace-nowrap" href="/contact">Contacto</a>
      </div>
    </div>
  </div>

  <div class="hero-content w-full container mx-auto flex flex-col justify-center">
    <p id="hi-im" class="text-3xl md:text-5xl italic font-serif text-gray-800 mb-2">
      Hola, Soy Axel
    </p>

    <h1
      id="hero-title"
      class="text-[4rem] md:text-[9rem] font-sans-akira uppercase tracking-tighter leading-[0.85]"
    >
      Full Stack <br /> Developer
    </h1>

    <p id="subtitle" class="text-xl font-semibold md:text-2xl mt-8 font-serif italic text-gray-600">
      UX / UI
    </p>
  </div>

  <div
    id="my-person"
    class="absolute top-[45%] right-10 flex flex-col items-center gap-2 z-20"
  >
    <span class="font-serif italic text-2xl text-gray-800 text-center leading-tight">
      Hey! estoy <br /> aquí :)
    </span>

    <svg width="40" height="40" viewBox="0 0 100 100" fill="none" class="ml-10 text-gray-800">
      <path
        d="M10 10 Q 50 30 80 80"
        stroke="currentColor"
        stroke-width="2"
        fill="none"
        stroke-linecap="round"
      />
      <path
        d="M65 85 L 80 80 L 85 65"
        stroke="currentColor"
        stroke-width="2"
        fill="none"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </div>

  <button
    class="absolute top-[55%] -right-12 w-24 h-24 bg-[#1a1a1a] rounded-full text-white flex items-center justify-start pl-4 hover:-translate-x-4 transition-transform duration-300 cursor-pointer z-30"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <line x1="19" y1="12" x2="5" y2="12"></line>
      <polyline points="12 19 5 12 12 5"></polyline>
    </svg>
  </button>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);


  // Animación de bienvenida
  gsap.set("#hi-im", {
    y: -20,
    opacity: 0
  });

  gsap.to("#hi-im", {
    y: 0,
    opacity: 1,
    duration: 1,
    delay: 2,
    ease: "power2.out",
    onComplete: () => {
      gsap.to('#hi-im', {
        y:20,
        opacity: 0,
        ease: "none",
        scrollTrigger: {
          trigger: "#hero",
          start: "top top",
          end: "bottom 50%",
          scrub: true,
          markers: true
        }
      }); 
    }
  });

  gsap.set("#subtitle", {
    y: 20,
    opacity: 0
  });

  gsap.to("#subtitle", {
    y: 0,
    opacity: 1,
    duration: 1,
    delay: 2.5,
    ease: "power2.out",
    onComplete: () => {
      gsap.to('#subtitle', {
        y:-20,
        opacity: 0,
        ease: "none",
        scrollTrigger: {
          trigger: "#hero",
          start: "top top",
          end: "bottom 50%",
          scrub: true,
          markers: true
        }
      }); 
    }
  });


  gsap.set("#hero-title", {
    y: -50,
    opacity: 0
  });

  // Aparición inicial del título
  gsap.to("#hero-title", {
    y: 0,
    opacity: 1,
    duration: 1,
    delay: 2.75,
    ease: "power2.out",
    onComplete: () => {
      // Fade al hacer scroll, y reaparece al volver arriba
      gsap.to("#hero-title", {
        y: 50,
        opacity: 0,
        ease: "none",
        scrollTrigger: {
          trigger: "#hero",
          start: "top top",
          end: "bottom 50%",
          scrub: true,
          markers: true
        }
      });
    }
  });

  // Dynamic Island
  const island = document.getElementById("dot");

  gsap.set("#dot", {
    transformOrigin: "center center"
  });

  const islandTl = gsap.timeline({ delay: 0.2 });

  islandTl
    .fromTo(
      "#dot",
      { scaleX: 0.2, scaleY: 0.2, y: -30, opacity: 0 },
      {
        scaleX: 1,
        scaleY: 1,
        y: 0,
        opacity: 1,
        duration: 0.8,
        ease: "back.out(1.5)"
      }
    )
    .to("#dot", {
      width: 250,
      duration: 0.5,
      ease: "power2.inOut"
    });

  function openIsland() {
  gsap.killTweensOf("#dot");
  gsap.killTweensOf("#links");

  gsap.to("#dot", {
    width: 550,
    duration: 0.25,
    ease: "power2.out"
  });

  gsap.to("#links", {
    opacity: 1,
    duration: 0.2,
    delay: 0.12,
    ease: "power2.out",
    pointerEvents: "auto"
  });
}

function closeIsland() {
  gsap.killTweensOf("#dot");
  gsap.killTweensOf("#links");

  gsap.to("#links", {
    opacity: 0,
    duration: 0.1,
    ease: "power2.out",
    pointerEvents: "none"
  });

  gsap.to("#dot", {
    width: 250,
    duration: 0.2,
    delay: 0.05,
    ease: "power2.out"
  });
}

island?.addEventListener("mouseenter", openIsland);
island?.addEventListener("mouseleave", closeIsland);
</script>