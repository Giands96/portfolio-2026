---
// src/components/Projects.astro
import reactlogo from "../assets/react.svg";
import mongodb from "../assets/mongodb.svg";
import nodejs from "../assets/nodejs02.svg";
import express from "../assets/express.svg";
import nextjs from "../assets/nextjs-fill.svg";
import typescript from "../assets/typescript-16.svg";
import postgresql from "../assets/postgresql.svg";
import spring from "../assets/spring.svg";
import wordpress from "../assets/wordpress.svg";
import astro from "../assets/astro.svg";
import tailwind from "../assets/tailwindcss.svg";
import docker from "../assets/docker.svg";
import elementor from "../assets/elementor.svg";
import { Image } from "astro:assets";
import Wasiq from "../assets/images/Wasiq.webp";
import ADStudio from "../assets/images/adstudio.webp";
import portfolio from "../assets/images/portfolio.webp";
import mernChat from "../assets/images/mernchat.webp";

interface Proyecto {
  id: string;
  title: string;
  imagen: any;
  description: string;
  url: string;
  url_svg: { src: string }[];
}

const proyectos: Proyecto[] = [
  {
    id: "01",
    title: "CHAT APP",
    imagen: mernChat,
    url: "https://mern-chat-2p49.onrender.com/",
    description:
      "Chat App desarrollado con el Stack MERN (MongoDB, Express, React, Node.js), permitiendo a los usuarios registrarse, iniciar sesión y enviar mensajes en tiempo real.",
    url_svg: [mongodb, express, reactlogo, nodejs],
  },
  {
    id: "02",
    title: "WASIQ",
    url: "https://wasiq-project-front.vercel.app/",
    imagen: Wasiq,
    description:
      "Plataforma inmobiliaria que permite gestionar propiedades, conectar compradores y vendedores, y optimizar el proceso de publicación y búsqueda. Desarrollado con Next.js, TypeScript, PostgreSQL, Spring, Tailwind CSS y Docker para una experiencia de usuario fluida y eficiente.",
    url_svg: [nextjs, typescript, postgresql, spring, tailwind, docker],
  },
  {
    id: "03",
    title: "AD Studio",
    url: "#",
    imagen: ADStudio,
    description:
      "Landing page para un estudio de diseño web, multimedia y marketing digital, desarrollado con WordPress y Elementor usando un diseño moderno y atractivo que destaca los servicios ofrecidos.",
    url_svg: [wordpress, elementor],
  },
  {
    id: "04",
    title: "Portafolio Personal",
    url: "https://axel-astro-portfolio.netlify.app/",
    imagen: portfolio,
    description:
      "Portafolio personal desarrollado con Astro y Tailwind CSS, diseñado para mostrar proyectos y habilidades de manera elegante y responsiva, con animaciones suaves y una experiencia de usuario optimizada.",
    url_svg: [astro, tailwind],
  },
  
];
---

<section
  class="projects-wrapper bg-[#222222] text-white py-24 h-screen overflow-hidden flex flex-col justify-center"
>
  <h2
    class="text-3xl md:text-4xl font-black text-center font-sans-akira mb-20 mt-8 uppercase letter-spacing-wide"
  >
    Mis Proyectos
  </h2>

  <div
    id="project-slider"
    class="projects-track flex gap-6 w-max px-8 md:px-16"
  >
    {
      proyectos.map((proyecto) => (
        <article class="project-card w-[85vw] flex flex-col h-[calc(100%-0px)] md:w-[600px] px-12 shrink-0 group cursor-pointer">
          <span class="text-4xl font-black mb-6 block text-neutral-100 font-sans-akira">
            {proyecto.id}
          </span>

          <a href={proyecto.url} class="overflow-hidden rounded-lg mb-6 bg-zinc-800">
            {proyecto.imagen ? (
              <Image
                src={proyecto.imagen}
                alt={proyecto.title}
                width={1440}
                height={1080}
                sizes="(max-width: 768px) 85vw, 600px"
                class="w-full h-84 object-cover rounded-xl group-hover:scale-105 transition-transform duration-300"
              />
            ) : (
              <div class="w-full h-78 bg-zinc-700 flex items-center justify-center">
                <span class="text-gray-500">Imagen no disponible</span>
              </div>
            )}
          </a>

          <div class="flex min-h-0 flex-1 flex-col">
            <h3 class="text-2xl uppercase mb-3 font-sans-akira mt-3 overflow-hidden text-ellipsis whitespace-nowrap">
              {proyecto.title}
            </h3>

            <p class="text-gray-400 text-md md:text-lg leading-relaxed mb-4 font-sans-inter overflow-hidden line-clamp-3 md:line-clamp-5">
              {proyecto.description}
            </p>

            <div class="flex gap-3 text-gray-500 mt-auto">
              {proyecto.url_svg.map((svg) => (
                <img src={svg.src} alt="Tecnología" class="w-8 h-8" />
              ))}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  //  slider horizontal gsap
  const track = document.querySelector(".projects-track");
  const wrapper = document.querySelector(".projects-wrapper");

  // GSAP necesita saber exactamente cuántos píxeles mover la pista hacia la izquierda.
  // Esto se calcula restando el ancho de la pantalla al ancho total de todos tus proyectos juntos.
  const getScrollAmount = () =>
    track ? -(track.scrollWidth - window.innerWidth) : 0;

  if (track && wrapper) {
    const tween = gsap.to(track, {
      x: getScrollAmount,
      ease: "none",
    });

    // Configuramos el "Trigger" que activa la animación
    ScrollTrigger.create({
      trigger: wrapper, // El contenedor que vamos a fijar en la pantalla
      start: "top top", // Cuando el tope del contenedor toque el tope de la pantalla
      end: () => `+=${getScrollAmount() * -1}`, // La duración del scroll vertical será igual al ancho de la pista
      pin: true, // Fixed
      animation: tween, // Conectamos la animación que creamos arriba
      scrub: 1, // Crea un efecto de arrastre suave (tarda 1 segundo en alcanzar al mouse)
      invalidateOnRefresh: true, // Recalcula las distancias si el usuario cambia el tamaño de la ventana
    });
  }

  // Resaltar nombres de tecnologías desde objeto descripción
  const projectCards = document.querySelectorAll(".project-card");
  const techNames = ["MongoDB", "Express", "React", "Node.js", "Next.js", "TypeScript", "PostgreSQL", "Spring", "WordPress", "Astro", "Tailwind CSS", "Elementor", "Docker"];

  projectCards.forEach((card) => {
    const description = card.querySelector("p");
    if (description) {
      let html = description.innerHTML;
      techNames.forEach((tech) => {
        const regex = new RegExp(`\\b${tech}\\b`, "g");
        html = html.replace(regex, `<span class="text-white font-normal">${tech}</span>`);
      });
      description.innerHTML = html;
    }
  })


</script>
